# Optional model orchestration. Without a key, the authenticated workspace uses
# its deterministic live-tool router instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4.3:nitro

# AniBot identity and public CTAs. Never infer the official token mint from a
# same-name search result; set it explicitly once the launch is final.
ANIBOT_TOKEN_MINT=
NEXT_PUBLIC_ANIBOT_PUMPFUN_URL=https://pump.fun
NEXT_PUBLIC_ANIBOT_X_URL=https://x.com
NEXT_PUBLIC_ANIBOT_GITHUB_URL=https://github.com/your-org/anibot

# Optional wallet intelligence.
HELIUS_API_KEY=

# Optional premium voice. Hume is preferred, then ElevenLabs, then browser speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
HUME_API_KEY=
HUME_VOICE_ID=

# Required for email + Solana wallet authentication.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Required for user records, synced conversations, usage events, and rate limits.
# Use Neon's pooled/serverless connection string.
DATABASE_URL=

# Bring your own licensed VRM. You can instead place it at public/models/avatar.vrm.
NEXT_PUBLIC_VRM_MODEL_URL=/models/avatar.vrm

# Reserved for the billing phase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
